# --- Postgres ---
POSTGRES_USER=hrms
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hrms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hrms:change_me@postgres:5432/hrms

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth / JWT ---
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- MinIO / S3 ---
S3_ENDPOINT_URL=http://minio:9000
# Used only when generating presigned URLs handed to browsers, which sit outside
# the Docker network and can't resolve the "minio" service hostname.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=change_me
S3_BUCKET_NAME=hrms-uploads
S3_REGION=us-east-1
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me

# --- App ---
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ENABLE_SWAGGER_UI=true

# --- Web (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
